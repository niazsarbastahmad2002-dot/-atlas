{
  "name": "atlas-clinic-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/ensure-tests.mjs && node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "whatsapp:readiness": "node scripts/whatsapp-meta-readiness.mjs",
    "whatsapp:prepare-templates": "node scripts/whatsapp-meta-readiness.mjs --apply",
    "whatsapp:release-gate": "node scripts/whatsapp-meta-readiness.mjs --require-live"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2"
  }
}
