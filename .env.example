# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SITE_URL=

# Phone-first authentication rollout.
# Keep phone signup false until every existing email-era Atlas account has
# verified a phone number onto the SAME Supabase auth user ID.
NEXT_PUBLIC_ATLAS_PHONE_SIGNUP_ENABLED=false
# Shows the WhatsApp delivery choice in phone OTP flows.
NEXT_PUBLIC_ATLAS_WHATSAPP_OTP_ENABLED=false
# When true, the WhatsApp choice still calls Supabase's normal phone OTP path;
# the Supabase Send SMS Hook delivers the generated OTP through Meta instead of
# requesting Supabase's Twilio-only native WhatsApp channel.
NEXT_PUBLIC_ATLAS_DIRECT_META_OTP_ENABLED=false
# Optional direct WhatsApp delivery field for secure receptionist invitations.
NEXT_PUBLIC_ATLAS_WHATSAPP_DIRECT_INVITES_ENABLED=false
# Temporary, unlinked migration route at /login/legacy. Disable permanently
# after all pre-phone accounts have verified their phone number.
ATLAS_LEGACY_AUTH_ENABLED=false

# Server-only configuration. Prefer a Supabase sb_secret_ key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Standard Webhooks secret issued when the Supabase Send SMS Hook is configured.
SUPABASE_SEND_SMS_HOOK_SECRET=

# Verified public company identity.
# Leave unset until every value is confirmed from the final legal registration
# and the company-domain mailbox/site are controlled by the legal entity.
ATLAS_LEGAL_ENTITY_NAME=
ATLAS_LEGAL_ENTITY_NAME_LOCAL=
ATLAS_COMPANY_REGISTRATION_NUMBER=
ATLAS_REGISTERED_BUSINESS_ADDRESS=
ATLAS_PUBLIC_BUSINESS_PHONE=
ATLAS_SUPPORT_EMAIL=
ATLAS_PRIVACY_EMAIL=
ATLAS_PUBLIC_SITE_URL=

# Apple release configuration. Configure only after the real Apple Developer
# organization is approved. Never commit the .p8 private-key value.
ATLAS_APPLE_TEAM_ID=
ATLAS_APPLE_APP_PREFIX=
ATLAS_APPLE_KEY_ID=
ATLAS_APPLE_PRIVATE_KEY=
ATLAS_IOS_BUNDLE_ID=com.atlasappointments.app
ATLAS_APPLE_WEB_CLIENT_ID=com.atlasappointments.app.web

# WhatsApp reminders (server-only)
WHATSAPP_ENABLED=false
# production (default) or meta_test. meta_test is rejected on Vercel production.
ATLAS_WHATSAPP_MODE=production
# meta (default), infobip, or 360dialog
WHATSAPP_PROVIDER=meta
WHATSAPP_GLOBAL_DAILY_LIMIT=
# Keep explicit until the corresponding production templates are approved.
WHATSAPP_DIRECT_OTP_ENABLED=false
WHATSAPP_DIRECT_INVITES_ENABLED=false
WHATSAPP_OTP_TEMPLATE=atlas_login_otp_v1
WHATSAPP_STAFF_INVITE_TEMPLATE=atlas_staff_invite_v1
WHATSAPP_WABA_ID=

# Direct Meta WhatsApp Cloud API production credentials.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=

# Meta official Cloud API test sender. Never reuse production credentials here.
# Test mode is hard-blocked when VERCEL_ENV=production. Meta itself limits its
# test WABA to explicitly registered recipients.
WHATSAPP_TEST_ENABLED=false
WHATSAPP_TEST_ACCESS_TOKEN=
WHATSAPP_TEST_PHONE_NUMBER_ID=
WHATSAPP_TEST_WABA_ID=
# Optional until testing signed inbound webhooks.
WHATSAPP_TEST_APP_SECRET=
WHATSAPP_TEST_VERIFY_TOKEN=
# Optional; Atlas falls back to v25.0 for the current test sender.
WHATSAPP_TEST_GRAPH_API_VERSION=
WHATSAPP_TEST_GLOBAL_DAILY_LIMIT=100
# Optional extra Atlas-side restriction; comma-separated E.164 numbers.
WHATSAPP_TEST_ALLOWED_RECIPIENTS=
# Protects /api/whatsapp/test/bootstrap and /api/whatsapp/test/send.
WHATSAPP_TEST_ADMIN_SECRET=
WHATSAPP_TEST_OTP_TEMPLATE=atlas_login_otp_v1
WHATSAPP_TEST_STAFF_INVITE_TEMPLATE=atlas_staff_invite_v1

# Personal ChatGPT -> WhatsApp bridge. Preview/test-only for now and intentionally
# separate from clinic credentials. Requires ATLAS_WHATSAPP_MODE=meta_test and
# the WHATSAPP_TEST_* sender above. Never enable these in Vercel Production.
WHATSAPP_PERSONAL_TOOL_ENABLED=false
# Generate a random server-only secret of at least 32 characters. This secret is
# used only by callers of /api/whatsapp/personal/send.
WHATSAPP_PERSONAL_TOOL_SECRET=
# Exposes the sandbox MCP tool at /api/mcp/whatsapp-test. Keep false unless a
# protected Preview deployment is being used for an explicit end-to-end test.
WHATSAPP_PERSONAL_MCP_ENABLED=false

# Meta Embedded Signup / WhatsApp Business App Coexistence readiness.
# Keep disabled until the Meta app has a valid Embedded Signup configuration.
META_EMBEDDED_SIGNUP_ENABLED=false
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# Infobip WhatsApp provider. Supports WhatsApp Business App coexistence onboarding.
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_WHATSAPP_SENDER=

# 360dialog WhatsApp provider. Direct API access after 360dialog Coexistence onboarding.
D360_API_KEY=
# Optional; defaults to https://waba-v2.360dialog.io
D360_BASE_URL=