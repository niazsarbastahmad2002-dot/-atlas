# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SITE_URL=

# Server-only configuration. Prefer a Supabase sb_secret_ key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# WhatsApp reminders (server-only)
WHATSAPP_ENABLED=false
# meta (default) or infobip
WHATSAPP_PROVIDER=meta
WHATSAPP_GLOBAL_DAILY_LIMIT=

# Direct Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=

# Infobip WhatsApp provider. Supports WhatsApp Business App coexistence onboarding.
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_WHATSAPP_SENDER=
