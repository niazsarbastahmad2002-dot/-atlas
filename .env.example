# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SITE_URL=

# Server-only configuration. Prefer a Supabase sb_secret_ key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Mandatory before ATLAS_WHATSAPP_AUTH_ENABLED=true.
# Use a stable random secret (32+ characters) so unrelated Supabase key rotation
# never changes Atlas phone identity/challenge hashes.
ATLAS_AUTH_SECRET=

# Verified public company identity.
# Leave unset until every value is confirmed from the final legal registration
# and the company-domain mailbox/site are controlled by the legal entity.
ATLAS_LEGAL_ENTITY_NAME=
ATLAS_LEGAL_ENTITY_NAME_LOCAL=
ATLAS_COMPANY_REGISTRATION_NUMBER=
ATLAS_REGISTERED_BUSINESS_ADDRESS=
ATLAS_PUBLIC_BUSINESS_PHONE=
ATLAS_SUPPORT_EMAIL=
ATLAS_PRIVACY_EMAIL=
ATLAS_PUBLIC_SITE_URL=

# Apple release configuration. Configure only after the real Apple Developer
# organization is approved. Never commit the .p8 private-key value.
ATLAS_APPLE_TEAM_ID=
ATLAS_APPLE_APP_PREFIX=
ATLAS_APPLE_KEY_ID=
ATLAS_APPLE_PRIVATE_KEY=
ATLAS_IOS_BUNDLE_ID=com.atlasappointments.app
ATLAS_APPLE_WEB_CLIENT_ID=com.atlasappointments.app.web

# WhatsApp (server-only)
WHATSAPP_ENABLED=false
# meta (default), infobip, or 360dialog for reminders. WhatsApp-first login
# codes and staff invitations support meta or 360dialog and remain separately
# disabled by ATLAS_WHATSAPP_AUTH_ENABLED.
WHATSAPP_PROVIDER=meta
WHATSAPP_GLOBAL_DAILY_LIMIT=

# Direct Meta WhatsApp Cloud API. The same Meta sender can deliver Atlas
# authentication templates, receptionist invitation templates, and reminders.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v26.0

# Independent kill-switch for login codes + phone-bound staff invitations.
# Keep false until the dedicated auth secret, selected provider credentials and
# approved templates have been verified against a real phone. Turning this on does not
# enable reminder delivery.
ATLAS_WHATSAPP_AUTH_ENABLED=false

# Atlas WhatsApp authentication template.
# Expected Meta template: AUTHENTICATION category with OTP copy-code button,
# 10-minute code expiry, and a short message-send TTL.
ATLAS_WHATSAPP_AUTH_TEMPLATE_NAME=atlas_login_code
ATLAS_WHATSAPP_AUTH_TEMPLATE_LANGUAGE=en_US

# Atlas receptionist invitation template.
# Expected Meta template contains a URL button whose dynamic suffix is the
# one-use invitation token, pointing to https://<atlas-domain>/join/{{1}}.
ATLAS_WHATSAPP_STAFF_INVITE_TEMPLATE_NAME=atlas_staff_invite
ATLAS_WHATSAPP_STAFF_INVITE_TEMPLATE_LANGUAGE=en_US

# Meta Embedded Signup / WhatsApp Business App Coexistence readiness.
# Keep disabled until the Meta app has a valid Embedded Signup configuration.
META_EMBEDDED_SIGNUP_ENABLED=false
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# Infobip WhatsApp provider. Supports WhatsApp Business App coexistence onboarding.
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_WHATSAPP_SENDER=

# 360dialog WhatsApp provider. Direct API access after 360dialog Coexistence onboarding.
D360_API_KEY=
# Optional; defaults to https://waba-v2.360dialog.io
# The sandbox base is https://waba-sandbox.360dialog.io, but its three fixed
# templates cannot validate Atlas login-code or staff-invite templates.
D360_BASE_URL=
